# =============================================================================
# OpenCode Configuration (Sole AI Provider)
# =============================================================================
# Mode: "api" (OpenCode Zen / OpenAI-compatible HTTP endpoint) or "cli" (`opencode run`)
OPENCODE_MODE=api

# OpenCode API Base URL (default: OpenCode Zen API)
OPENCODE_BASE_URL=https://opencode.ai/zen/v1

# OpenCode API Key (use "public" for free OpenCode Zen models or your Zen key)
OPENCODE_API_KEY=public

# Default OpenCode model ID (e.g., big-pickle, grok-code, or opencode/<model-id>)
OPENCODE_MODEL=big-pickle

# Optional CLI binary path when OPENCODE_MODE=cli
OPENCODE_CLI_PATH=opencode

# =============================================================================
# Telegram Bot Configuration
# =============================================================================
TELEGRAM_BOT_TOKEN=
# Required when using webhook mode; use a long random value (never commit real secrets).
TELEGRAM_WEBHOOK_SECRET=
# Comma-separated Telegram user IDs allowed to use this private assistant.
# Leave empty to deny all users. Get your numeric user ID from @userinfobot.
# This is an authorization allowlist; a separate TELEGRAM_CHAT_ID is not needed for polling.
TELEGRAM_ALLOWED_USER_IDS=
# Set true only if you intentionally want anyone to use this bot (not recommended).
TELEGRAM_ALLOW_ALL_USERS=false
# Enable background long-polling instead of webhook (true/false).
TELEGRAM_POLLING=false

# =============================================================================
# Google Calendar & Google Sheets Configuration
# =============================================================================
# Path to Google Service Account JSON file OR inline JSON string
GOOGLE_SERVICE_ACCOUNT_FILE=
GOOGLE_SERVICE_ACCOUNT_JSON=

# Target Calendar ID (e.g. "primary" or your email address)
GOOGLE_CALENDAR_ID=primary

# Target Google Spreadsheet ID for reading/appending rows
GOOGLE_SPREADSHEET_ID=
GOOGLE_DEFAULT_SHEET_RANGE=Sheet1!A:E

# =============================================================================
# Workspace cadence and SQLite database
# =============================================================================
# Default timezone for opt-in Telegram briefs (can be changed per user via /brief timezone)
USER_TIMEZONE=Asia/Riyadh
SQLITE_DB_PATH=data/agent.db
HOST=0.0.0.0
PORT=8000

# =============================================================================
# Clinical Evidence APIs (optional — all work without keys at lower rate limits)
# =============================================================================
# NCBI API key: raises PubMed E-utilities from 3 req/s to 10 req/s
# Get one at: https://www.ncbi.nlm.nih.gov/account/settings/
NCBI_API_KEY=

# openFDA API key: raises from 120/min to 240/min, 120k/day
# Get one at: https://open.fda.gov/apis/authorization/
OPENFDA_API_KEY=

# UMLS API key: required for UMLS terminology services (20 req/s)
# Get one at: https://uts.nlm.nih.gov/uts/
UMLS_API_KEY=

# Cache TTL for clinical evidence results (seconds, default 24h)
CLINICAL_EVIDENCE_CACHE_TTL=86400

# Default lookback window for clinical searches (years)
RETRIEVAL_DEFAULT_WINDOW_YEARS=5
