# =============================================================================
# OpenCode Configuration (Sole AI Provider)
# =============================================================================
# Mode: "api" (OpenCode Zen / OpenAI-compatible HTTP endpoint) or "cli" (`opencode run`)
OPENCODE_MODE=api

# OpenCode API Base URL (default: OpenCode Zen API)
OPENCODE_BASE_URL=https://opencode.ai/zen/v1

# OpenCode API Key — REQUIRED.
# Get one at https://opencode.ai/auth
#
# IMPORTANT (changed 2026-09-23): OpenCode Zen closed anonymous free-tier access
# to third-party apps. The old placeholder value "public" no longer works and
# makes the bot appear dead (403 FreeTierError / 401 / 429). Put a real key here,
# or set OPENCODE_MODE=cli below to use the official CLI's free tier instead.
OPENCODE_API_KEY=sk-your-real-key-here

# Default OpenCode model ID (e.g., big-pickle, deepseek-v4-flash, or opencode/<model-id>)
# Verify what your key can use with: curl $OPENCODE_BASE_URL/models -H "Authorization: Bearer $OPENCODE_API_KEY"
OPENCODE_MODEL=big-pickle

# Optional CLI binary path when OPENCODE_MODE=cli
OPENCODE_CLI_PATH=opencode

# =============================================================================
# Telegram Bot Configuration
# =============================================================================
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
# Comma-separated list of allowed Telegram user IDs (leave empty to allow all)
TELEGRAM_ALLOWED_USER_IDS=
# Enable background long-polling instead of webhook (true/false)
# Only ONE delivery mode may be active. When polling starts, the app automatically
# calls deleteWebhook so a leftover webhook can't make getUpdates fail with 409
# Conflict (which looks exactly like a dead bot). Also make sure only ONE instance
# of this app runs per bot token.
TELEGRAM_POLLING=false

# =============================================================================
# Google Calendar & Google Sheets Configuration
# =============================================================================
# Path to Google Service Account JSON file OR inline JSON string
GOOGLE_SERVICE_ACCOUNT_FILE=
GOOGLE_SERVICE_ACCOUNT_JSON=

# Target Calendar ID (e.g. "primary" or your email address)
GOOGLE_CALENDAR_ID=primary

# Target Google Spreadsheet ID for reading/appending rows
GOOGLE_SPREADSHEET_ID=
GOOGLE_DEFAULT_SHEET_RANGE=Sheet1!A:E

# =============================================================================
# Application & SQLite Database Configuration
# =============================================================================
SQLITE_DB_PATH=data/agent.db
HOST=0.0.0.0
PORT=8000

# Log verbosity: DEBUG, INFO, WARNING, ERROR (default INFO)
# WARNING+ logs are also kept in memory and returned by GET /api/diagnostics.
LOG_LEVEL=INFO
